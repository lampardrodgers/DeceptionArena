{
  "name": "pokesolo",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "description": "Kaiji One Poker (賭博黙示録カイジ 和也編 ワンポーカー) — three.js web game, human vs LLM Kazuya",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 13460",
